# Copy to .env (gitignored) to run `npm run test:quote` against real Resend.
# Production does NOT read this file: set the same names in
# Vercel → Project → Settings → Environment Variables.

# Required
RESEND_API_KEY=xxxxxx
QUOTE_TO=contact@vetrosteelut.com
QUOTE_FROM=Vetro Steel <quotes@vetrosteelut.com>

# Optional
QUOTE_BCC=
QUOTE_REPLY_TO=

# test:quote only — where the visitor acknowledgement is sent during the check
QUOTE_TEST_TO=
