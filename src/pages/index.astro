---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import VerticalSplit from '../components/VerticalSplit.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import ValuesStrip from '../components/ValuesStrip.astro';
import TaglineMarquee from '../components/TaglineMarquee.astro';
import CTABand from '../components/ui/CTABand.astro';
import Footer from '../components/Footer.astro';
import { verticals, commercial } from '../data/verticals';

/**
 * Home is the fork, not the whole story: hero, the lines of work, who we are,
 * what backs the work, a sample of it, and one way to start a conversation.
 * Mission / Vision / Values now live on /about.
 */
// Interleaves every line rather than indexing fixed positions: hard-coded
// indices broke the build the moment a gallery got shorter, and naming two
// verticals left the third one out of the home gallery entirely.
const featured = Array.from({ length: 3 }, (_, i) => verticals.map((v) => v.gallery[i]))
  .flat()
  .filter((item) => item !== undefined)
  .slice(0, 6);
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <VerticalSplit />
    <About compact />
    <Services limit={3} more />
    <ProjectGallery
      eyebrow="Our craft"
      title="Built for visionary projects"
      lead="Tempered glass and stainless steel, engineered to fit and built to last — across every line of work."
      items={featured}
      gaps={[commercial.gaps[0]]}
    />
    <ValuesStrip />
    <TaglineMarquee />
    <CTABand
      headline="Let's build something made to last"
      body="Tell us about the project — a storefront, a bathroom or a floor to keep running — and we'll come back with a system, a drawing and a number."
    />
  </main>
  <Footer />
</Layout>
