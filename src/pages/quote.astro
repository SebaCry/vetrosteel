---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { verticals } from '../data/verticals';

const steps = [
  'We read it the same day and come back within one business day.',
  'If it needs a site visit to price properly, we say so rather than guessing.',
  'You get a written quote with the system, the hardware and the finish named.',
];
---

<Layout
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Request a Quote', href: '/quote' },
  ]}
  includeFaq
>
  <Nav />
  <main id="main">
    <PageHeader
      crumb="Request a Quote"
      eyebrow="Let's talk"
      title="Tell us what you're building"
      lead="Rough dimensions and a photo are usually enough to come back with a system and a number."
    />

    <section class="relative bg-ink text-warm-gray py-20 sm:py-24 overflow-hidden">
      <div class="absolute inset-0 blueprint-grid opacity-25"></div>

      <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
          <!-- What happens next -->
          <aside class="lg:col-span-4 order-2 lg:order-1" data-reveal>
            <p class="text-[0.66rem] uppercase tracking-[0.26em] text-sand/80 mb-6">
              What happens next
            </p>
            <ol class="space-y-6">
              {
                steps.map((s, i) => (
                  <li class="flex gap-4">
                    <span class="font-display text-sand/60 text-sm pt-0.5">0{i + 1}</span>
                    <p class="text-sm leading-relaxed text-warm-gray/65">{s}</p>
                  </li>
                ))
              }
            </ol>

            <div class="mt-10 pt-8 border-t border-white/10">
              <p class="text-[0.66rem] uppercase tracking-[0.26em] text-sand/80 mb-5">
                Lines of work
              </p>
              <ul class="space-y-3">
                {
                  verticals.map((v) => (
                    <li>
                      <a
                        href={`/${v.slug}`}
                        class="group inline-flex items-center gap-2 text-sm text-warm-gray/75 hover:text-sand transition-colors"
                      >
                        {v.nav}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-0.5" aria-hidden="true">
                          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-8 text-sm text-warm-gray/50 leading-relaxed">
                {site.region}
                <br />
                <a href={`mailto:${site.email}`} class="text-sand hover:underline">{site.email}</a>
              </p>
            </div>
          </aside>

          <!-- Form -->
          <div class="lg:col-span-8 order-1 lg:order-2" data-reveal style="--reveal-delay:120ms">
            <QuoteForm />
          </div>
        </div>
      </div>
    </section>
    <Faq />
  </main>
  <Footer />
</Layout>
