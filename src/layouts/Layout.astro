---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { name: string; href: string }[];
  includeFaq?: boolean;
  noindex?: boolean;
}

// Everything search-related is delegated to <Seo>, which falls back to the
// route table in src/data/seo.ts when a page passes nothing.
const { title, description, breadcrumbs, includeFaq, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      includeFaq={includeFaq}
      noindex={noindex}
    />

    <meta name="theme-color" content="#0f3b46" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-4 focus:left-4 focus:bg-sand focus:text-ink focus:px-5 focus:py-3 focus:font-semibold focus:uppercase focus:tracking-[0.14em] focus:text-[0.8rem]"
    >
      Skip to content
    </a>

    <slot />

    <script>
      import Lenis from 'lenis';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* ---------------------------------------------------------------- */
      /*  Scroll reveal — unchanged behaviour, CSS handles reduced motion.  */
      /* ---------------------------------------------------------------- */
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      /* ---------------------------------------------------------------- */
      /*  Parallax — a slow counter-drift on hero photography. Deliberately */
      /*  small: 44px of travel over a full viewport of scroll.             */
      /* ---------------------------------------------------------------- */
      const parallax = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      const TRAVEL = 44;

      const updateParallax = () => {
        if (!parallax.length) return;
        // An inline custom property outranks the reduced-motion rule in CSS,
        // so the loop has to stand down here rather than be overridden there.
        if (reduced.matches) {
          for (const el of parallax) el.style.removeProperty('--py');
          return;
        }
        const vh = window.innerHeight;
        for (const el of parallax) {
          const r = el.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) continue;
          // -1 above the fold, 0 centred, 1 below.
          const progress = (r.top + r.height / 2 - vh / 2) / vh;
          el.style.setProperty('--py', `${(progress * TRAVEL).toFixed(1)}px`);
        }
      };

      /* ---------------------------------------------------------------- */
      /*  Lenis — skipped entirely under reduced motion, where the native   */
      /*  scroll is the correct behaviour.                                  */
      /* ---------------------------------------------------------------- */
      let lenis: InstanceType<typeof Lenis> | null = null;

      const startLenis = () => {
        if (lenis || reduced.matches) return;
        lenis = new Lenis({
          duration: 1.15,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.4,
        });
        lenis.on('scroll', updateParallax);
        const raf = (time: number) => {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      };

      const stopLenis = () => {
        lenis?.destroy();
        lenis = null;
        document.documentElement.classList.remove('lenis', 'lenis-smooth');
      };

      startLenis();
      reduced.addEventListener('change', () => {
        if (reduced.matches) stopLenis();
        else startLenis();
      });

      if (!lenis) window.addEventListener('scroll', updateParallax, { passive: true });
      window.addEventListener('resize', updateParallax, { passive: true });
      updateParallax();

      /* ---------------------------------------------------------------- */
      /*  In-page anchors need to go through Lenis, not the browser.        */
      /* ---------------------------------------------------------------- */
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link || !lenis) return;
        const id = link.getAttribute('href')!;
        if (id === '#' || id.length < 2) return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        // Measured, not assumed: the bar is 113px on desktop and 72px on a
        // phone, and a fixed -96 put desktop targets underneath it.
        const bar = document.getElementById('site-nav');
        const offset = -((bar?.getBoundingClientRect().height ?? 96) + 16);
        lenis.scrollTo(target as HTMLElement, { offset });
        history.pushState(null, '', id);
      });
    </script>
  </body>
</html>
