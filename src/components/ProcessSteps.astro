---
import SectionHeader from './ui/SectionHeader.astro';
import type { ProcessStep } from '../data/verticals';

interface Props {
  steps: ProcessStep[];
  title?: string;
  lead?: string;
}
const {
  steps,
  title = 'From first call to hand-over',
  lead = 'Four stages, and we are the ones accountable at each of them.',
} = Astro.props;
---

<section id="process" class="relative bg-ink text-warm-gray py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeader eyebrow="Process" title={title} lead={lead} tone="dark" class="mb-16" />

    <ol class="relative grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10 border border-white/10">
      {
        steps.map((s, i) => (
          <li
            class="relative bg-ink p-8 sm:p-9 group hover:bg-deep-teal/60 transition-colors duration-500"
            data-reveal
            style={`--reveal-delay:${i * 110}ms`}
          >
            <div class="flex items-baseline gap-4">
              <span class="font-display text-3xl font-semibold text-sand/45 group-hover:text-sand transition-colors duration-500">
                0{i + 1}
              </span>
              <span class="h-px flex-1 bg-white/12 group-hover:bg-sand/40 transition-colors duration-500" />
            </div>
            <h3 class="mt-6 font-display text-xl font-semibold text-warm-gray tracking-wide">
              {s.title}
            </h3>
            <p class="mt-3.5 text-sm leading-relaxed text-warm-gray/62">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
