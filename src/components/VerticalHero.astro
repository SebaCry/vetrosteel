---
import Figure from './ui/Figure.astro';
import type { Vertical } from '../data/verticals';
import { site } from '../data/site';

interface Props {
  vertical: Vertical;
}
const { vertical: v } = Astro.props;

/**
 * The secondary CTA points at whatever this vertical actually renders below.
 * It used to be a hard-coded "#technical", which is the plan viewer's id — on a
 * line that ships no drawings that button scrolled nowhere.
 */
const secondary = v.plans?.length
  ? { href: '#technical', label: 'See the drawings' }
  : v.serviceGroups?.length
    ? { href: '#scope', label: 'What we cover' }
    : { href: '#process', label: 'How we work' };
---

<section class="relative isolate min-h-[78svh] lg:min-h-[86svh] flex items-end overflow-hidden bg-ink">
  <div class="absolute inset-0 -z-10">
    <Figure
      src={v.hero.image}
      alt={v.hero.alt}
      fill
      sizes="100vw"
      widths={[800, 1280, 1800, 2400, 3200]}
      eager
      parallax
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg, rgba(7,30,36,0.78) 0%, rgba(7,30,36,0.45) 45%, rgba(7,30,36,0) 75%), linear-gradient(180deg, rgba(7,30,36,0.6) 0%, rgba(7,30,36,0) 35%, rgba(7,30,36,0.7) 100%);"
    >
    </div>
    <div class="absolute inset-0 blueprint-grid opacity-20"></div>
  </div>

  <div class="mx-auto max-w-7xl w-full px-5 sm:px-8 pt-36 pb-16 sm:pb-20">
    <nav aria-label="Breadcrumb" class="mb-8" data-reveal>
      <ol class="flex items-center gap-2 text-[0.7rem] uppercase tracking-[0.2em] text-warm-gray/45">
        <li><a href="/" class="hover:text-sand transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-sand/90">{v.nav}</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <p class="eyebrow text-light-teal mb-7 flex items-center gap-3" data-reveal style="--reveal-delay:60ms">
        <span class="inline-block w-9 h-px bg-sand"></span>
        {site.tagline}
      </p>

      <h1
        class="font-display font-semibold text-warm-gray leading-[1.1] text-3xl sm:text-5xl lg:text-[3.25rem] drop-shadow-[0_2px_16px_rgba(7,30,36,0.6)]"
        data-reveal
        style="--reveal-delay:130ms"
      >
        {v.headline}
      </h1>

      <p
        class="mt-8 max-w-xl text-base sm:text-lg leading-relaxed text-warm-gray/75"
        data-reveal
        style="--reveal-delay:240ms"
      >
        {v.lead}
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay:340ms">
        <a
          href={`/quote?for=${v.slug}`}
          class="group inline-flex items-center justify-center gap-2 bg-sand text-ink font-semibold uppercase tracking-[0.14em] text-[0.82rem] px-7 py-4 hover:bg-sand-bright transition-colors duration-300"
        >
          Request a quote
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={secondary.href}
          class="inline-flex items-center justify-center gap-2 border border-light-teal/40 text-warm-gray font-semibold uppercase tracking-[0.14em] text-[0.82rem] px-7 py-4 hover:border-sand hover:text-sand transition-colors duration-300"
        >
          {secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
