---
import { site } from '../data/site';
import { seoFor, buildGraph } from '../data/seo';

/**
 * Every head tag that search engines and social crawlers read, in one place.
 *
 * Defaults come from the route table in src/data/seo.ts, so a page only passes
 * what it needs to override. Astro renders this at build time, which is the
 * whole point: crawlers get complete markup in the first response with no
 * client-side hydration to wait on.
 */
interface Props {
  title?: string;
  description?: string;
  /** Path under /og/ for the generated share image. Defaults to the route. */
  ogSlug?: string;
  breadcrumbs?: { name: string; href: string }[];
  includeFaq?: boolean;
  /** Keeps a page out of the index without removing it from the site. */
  noindex?: boolean;
}

const { title, description, ogSlug, breadcrumbs, includeFaq = false, noindex = false } = Astro.props;

// With build.format 'file' the pathname arrives as "/commercial.html", and with
// 'directory' as "/commercial/". Normalising here means the route table, the
// canonical and the OG slug all agree no matter which format is configured.
const clean =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/\/+$/, '') || '/';

const preset = seoFor(clean);

const pageTitle = title ?? preset.title;
const pageDescription = description ?? preset.description;

// One canonical shape, so the canonical never disagrees with the sitemap:
// two URLs for one page is the cheapest way to split your own ranking.
const canonical = new URL(clean, site.origin).href;

const ogPath = ogSlug ?? (clean === '/' ? 'home' : clean.slice(1).replace(/\//g, '-'));
const ogImage = new URL(`/og/${ogPath}.png`, site.origin).href;

const graph = buildGraph({
  pathname: clean,
  title: pageTitle,
  description: pageDescription,
  image: ogImage,
  breadcrumbs,
  includeFaq,
});
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  )
}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Local business signals that are not expressible in schema alone -->
<meta name="geo.region" content="US-UT" />
<meta name="geo.placename" content={site.address.locality} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(graph)}
/>
