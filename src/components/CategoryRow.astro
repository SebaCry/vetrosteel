---
import { Icon } from 'astro-icon/components';
import Figure from './ui/Figure.astro';
import SectionHeader from './ui/SectionHeader.astro';
import type { CategoryItem } from '../data/verticals';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  items: CategoryItem[];
}
const { eyebrow, title, lead, items } = Astro.props;
---

<section class="relative bg-paper text-ink py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} tone="light" class="mb-16" />

    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {
        items.map((item, i) => (
          <article class="group" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <div class="tick-frame p-2.5">
              <Figure
                src={item.image}
                alt={item.title}
                ratio="aspect-[4/3]"
                sizes="(min-width:768px) 31vw, 92vw"
                widths={[420, 700, 1000, 1400]}
                imgClass="transition-transform duration-[1100ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
              />
            </div>
            <div class="mt-7 flex items-center gap-4">
              <span class="grid place-items-center size-12 shrink-0 bg-deep-teal text-sand">
                <Icon name={item.icon} class="size-6" />
              </span>
              <h3 class="font-display text-xl font-semibold text-deep-teal tracking-wide">
                {item.title}
              </h3>
            </div>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-ink/65">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
