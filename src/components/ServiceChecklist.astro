---
import { Icon } from 'astro-icon/components';
import SectionHeader from './ui/SectionHeader.astro';
import MaterialNote from './ui/MaterialNote.astro';
import type { ServiceGroup } from '../data/verticals';

/**
 * The covered-work list, group by group.
 *
 * Deliberately a list and not a card grid: a facilities manager reads this to
 * check whether a specific task is in scope, and a list is what you scan for
 * that. The tick marks echo the drafting motif used elsewhere.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  groups: ServiceGroup[];
  gap?: { where: string; needs: string };
}
const { eyebrow = 'Scope', title, lead, groups, gap } = Astro.props;
---

<section id="scope" class="relative bg-paper text-ink py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} tone="light" class="mb-14" />

    {gap && <MaterialNote where={gap.where} needs={gap.needs} />}

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
      {
        groups.map((g, gi) => (
          <div data-reveal style={`--reveal-delay:${gi * 120}ms`}>
            <div class="flex items-baseline gap-4 border-b border-ink/12 pb-5">
              <span class="font-display text-2xl font-semibold text-sand">0{gi + 1}</span>
              <div>
                <h3 class="font-display text-xl sm:text-2xl font-semibold text-deep-teal tracking-wide">
                  {g.title}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink/55">{g.note}</p>
              </div>
            </div>

            <ul class="mt-2">
              {g.items.map((item) => (
                <li class="flex items-start gap-5 border-b border-ink/8 py-5">
                  <span class="grid place-items-center size-12 shrink-0 bg-deep-teal text-sand">
                    <Icon name={item.icon} class="size-6" />
                  </span>
                  <div>
                    <h4 class="font-semibold text-deep-teal">{item.title}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-ink/65">{item.body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
