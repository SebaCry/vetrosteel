---
import Logo from './Logo.astro';
import { mainNav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-500 border-b border-transparent"
>
  <nav
    class="mx-auto max-w-7xl px-3 sm:px-8 flex items-center justify-between min-h-[88px] sm:min-h-[96px] py-1.5 sm:py-2"
    aria-label="Main"
  >
    <a href="/" class="flex items-center shrink-0" aria-label={`${'Vetro Steel'} — home`}>
      <Logo variant="full" tone="light" class="h-20 sm:h-24" />
    </a>

    <div class="hidden md:flex items-center gap-9">
      {
        mainNav.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'relative text-[0.82rem] tracking-[0.14em] uppercase font-medium transition-colors duration-300 py-1',
              isActive(l.href) ? 'text-sand' : 'text-warm-gray/75 hover:text-sand',
            ]}
          >
            {l.label}
            {isActive(l.href) && <span class="absolute -bottom-0.5 inset-x-0 h-px bg-sand" />}
          </a>
        ))
      }
      <a
        href="/quote"
        class="text-[0.82rem] tracking-[0.14em] uppercase font-semibold text-ink bg-sand px-5 py-2.5 hover:bg-sand-bright transition-colors duration-300"
      >
        Request a Quote
      </a>
    </div>

    <button
      id="menu-toggle"
      class="md:hidden text-warm-gray p-2 -mr-2"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>

  <!-- Mobile panel -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-out bg-ink/98 backdrop-blur border-t border-white/5"
  >
    <div class="px-6 py-6 flex flex-col gap-5">
      {
        mainNav.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'text-sm tracking-[0.18em] uppercase transition-colors',
              isActive(l.href) ? 'text-sand' : 'text-warm-gray/85 hover:text-sand',
            ]}
            data-close
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/quote"
        class="text-sm tracking-[0.18em] uppercase font-semibold text-ink bg-sand px-5 py-3 text-center"
        data-close
      >
        Request a Quote
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const SOLID = ['bg-ink/90', 'backdrop-blur-md', 'border-white/5', 'shadow-[0_10px_40px_-20px_rgba(0,0,0,0.8)]'];

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add(...SOLID);
      nav.classList.remove('border-transparent');
    } else {
      nav.classList.remove(...SOLID);
      nav.classList.add('border-transparent');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  let open = false;

  const setOpen = (next: boolean) => {
    if (!menu || !toggle) return;
    open = next;
    menu.style.maxHeight = next ? `${menu.scrollHeight}px` : '0px';
    toggle.setAttribute('aria-expanded', String(next));
    toggle.setAttribute('aria-label', next ? 'Close menu' : 'Open menu');
  };

  toggle?.addEventListener('click', () => setOpen(!open));
  document.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', () => setOpen(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
