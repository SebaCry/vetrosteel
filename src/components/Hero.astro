---
import { site } from '../data/site';
import ClipPlayer from './ui/ClipPlayer.astro';
import { stages } from '../data/showcase';

// Background clip. `office-glass-suite` is the only one with no burnt-in
// callouts and a single continuous camera move, which is what a backdrop
// needs — the split-screen drawing clips have a white half that would sit
// straight under the headline. Swapping this for the client's new clip is a
// one-line change once the file lands in public/video.
const bg = stages[2];

// The hero runs a tighter window than the card on /projects. The clip is one
// long push-in: it opens on a near-empty dark room and ends in a macro so close
// it stops reading as glass. Only the middle stretch works as a backdrop.
const bgStart = 1.8;
const bgEnd = 5.0;

// The offer, said plainly and rotated. This is the "what do they actually
// sell" line: a visitor should know inside two seconds.
const offers = [
  'office partitions',
  'a stainless handrail',
  'a shower enclosure',
  'a storefront entrance',
];

// Radiating "cable" lines — evokes the cable-stayed bridge of the brand deck
// and the vanishing-point perspective of a technical drawing.
// viewBox is 160x100 — the same 16:10 aspect as the hero — so scaling is
// uniform (no distortion) and nothing is cropped. Cables fan from a single
// point near the top and descend across the sheet, echoing the cable-stayed
// bridge of the brand deck and a technical perspective drawing.
const vx = 108; // vanishing point x (of 160)
const vy = 6; // vanishing point y (of 100)
const rays = Array.from({ length: 26 }, (_, i) => {
  const t = i / 25;
  const x2 = 178 - t * 210; // endpoints sweep the bottom edge, right → left
  const y2 = 118; // just past the bottom edge
  const strong = i % 4 === 0;
  return { x1: vx, y1: vy, x2, y2, strong };
});
---

<section id="top" class="relative isolate min-h-[100svh] flex items-center overflow-hidden bg-ink">
  <!-- Layered background: gradient + blueprint grid + radiating cables -->
  <div class="absolute inset-0 -z-10">
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(110% 95% at 68% 0%, #1a5563 0%, #0e3742 42%, #071e24 100%);"
    >
    </div>
    <!-- The clip is the backdrop. Its poster paints first, so the fold never
         waits on video bytes. -->
    <ClipPlayer
      slug={bg.slug}
      title={bg.title}
      start={bgStart}
      end={bgEnd}
      variant="background"
      class="absolute inset-0 opacity-70"
    />

    <div class="absolute inset-0 blueprint-grid opacity-40"></div>

    <svg
      class="absolute inset-0 w-full h-full"
      viewBox="0 0 160 100"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {rays.map((r, i) => (
        <line
          x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2}
          stroke={r.strong ? '#d9c39c' : '#a7c4c9'}
          stroke-width={r.strong ? 2 : 1}
          vector-effect="non-scaling-stroke"
          opacity={r.strong ? 0.5 : 0.28}
          class="ray"
          style={`--i:${i}`}
        />
      ))}
      <!-- vanishing point node -->
      <circle cx={vx} cy={vy} r="0.7" fill="#c8b28a" opacity="0.8" />
    </svg>

    <!-- vignette for legibility -->
    <div class="hero-scrim absolute inset-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-40" style="background:linear-gradient(to top,#071e24, transparent);"></div>
  </div>

  <div class="mx-auto max-w-7xl w-full px-5 sm:px-8 pt-36 sm:pt-32 lg:pt-28 pb-28 sm:pb-24">
    <div class="max-w-3xl">
      <p class="eyebrow text-light-teal mb-7 flex items-center gap-3" data-reveal>
        <span class="inline-block w-9 h-px bg-sand"></span>
        {site.tagline}
      </p>

      <h1
        class="font-display font-semibold text-warm-gray leading-[1.05] text-5xl sm:text-6xl lg:text-7xl"
        data-reveal
        style="--reveal-delay:80ms"
      >
        Precision.<br />
        <span class="text-sand">Strength.</span><br />
        Elegance.
      </h1>

      <!-- The offer, in the plainest words available. The rotating half is
           aria-hidden and the full list is read out once instead. -->
      <p
        class="mt-9 font-display text-xl sm:text-2xl lg:text-[1.75rem] leading-snug text-warm-gray"
        data-reveal
        style="--reveal-delay:170ms"
      >
        <span aria-hidden="true">
          Need <span class="rotator" data-rotator>
            {offers.map((o, i) => (
              <span class:list={['rot-item', i === 0 && 'is-active']}>{o}?</span>
            ))}
          </span><br class="hidden sm:block" />
          <span class="text-sand">We draw it, fabricate it and install it.</span>
        </span>
        <span class="sr-only">
          Need office partitions, a stainless handrail, a shower enclosure or a
          storefront entrance? We draw it, fabricate it and install it.
        </span>
      </p>

      <p
        class="mt-7 max-w-xl text-base sm:text-lg leading-relaxed text-warm-gray/75"
        data-reveal
        style="--reveal-delay:250ms"
      >
        Shower enclosures, sliding systems, railings and entrance systems in
        tempered glass and stainless steel — specified from our own hardware
        catalog, cut to dimensioned templates, and installed by the people who
        drew them.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay:340ms">
        <a
          href="#verticals"
          class="group inline-flex items-center justify-center gap-2 bg-sand text-ink font-semibold uppercase tracking-[0.14em] text-[0.82rem] px-7 py-4 hover:bg-sand-bright transition-colors duration-300"
        >
          See both lines
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="/quote"
          class="inline-flex items-center justify-center gap-2 border border-light-teal/40 text-warm-gray font-semibold uppercase tracking-[0.14em] text-[0.82rem] px-7 py-4 hover:border-sand hover:text-sand transition-colors duration-300"
        >
          Request a quote
        </a>
      </div>
    </div>
  </div>

  <!-- bottom credential strip -->
  <div class="absolute bottom-0 inset-x-0 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-5 flex flex-wrap items-center gap-x-7 gap-y-2 text-[0.7rem] tracking-[0.22em] uppercase text-warm-gray/45">
      <span class="text-sand/80">{site.location}</span>
      {
        site.catalogCategories.map((c, i) => (
          <span class:list={[i > 2 ? 'hidden lg:inline' : i > 0 ? 'hidden sm:inline' : '']}>{c}</span>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The copy sits in the left third on a wide screen, so the wash runs
     sideways there. On a phone the copy spans the full width, and that same
     wash simply blacked the clip out — so it flips to a gentler vertical one. */
  .hero-scrim {
    background:
      linear-gradient(
        to bottom,
        rgba(7, 30, 36, 0.78) 0%,
        rgba(7, 30, 36, 0.52) 40%,
        rgba(7, 30, 36, 0.88) 100%
      );
  }
  @media (min-width: 1024px) {
    .hero-scrim {
      background:
        linear-gradient(
          90deg,
          rgba(7, 30, 36, 0.95) 0%,
          rgba(7, 30, 36, 0.86) 30%,
          rgba(7, 30, 36, 0.55) 58%,
          rgba(7, 30, 36, 0.28) 100%
        ),
        linear-gradient(
          to bottom,
          rgba(7, 30, 36, 0.5) 0%,
          rgba(7, 30, 36, 0.08) 38%,
          rgba(7, 30, 36, 0.35) 100%
        );
    }
  }

  /* inline-grid stacks every option in one cell, so the line is sized by the
     longest term and nothing reflows as they swap. */
  .rotator {
    display: inline-grid;
    vertical-align: bottom;
  }
  .rot-item {
    grid-area: 1 / 1;
    white-space: nowrap;
    color: var(--color-sand);
    opacity: 0;
    transform: translateY(0.3em);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
  }
  .rot-item.is-active {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rot-item {
      transition: none;
    }
  }

  @keyframes ray-in {
    from { opacity: 0; }
  }
  .ray {
    /* base opacity comes from each line's `opacity` attribute;
       `both` fill keeps it hidden during the stagger delay, then holds the end */
    animation: ray-in 1.3s var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) both;
    animation-delay: calc(var(--i) * 40ms + 200ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .ray { animation: none; }
  }
</style>

<script>
  // Rotates the offer term. Frozen under reduced motion and while the tab is
  // hidden, so it is not animating for nobody.
  const rotator = document.querySelector<HTMLElement>('[data-rotator]');
  if (rotator) {
    const items = Array.from(rotator.querySelectorAll<HTMLElement>('.rot-item'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0;
    let timer: number | undefined;

    const step = () => {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    };

    const start = () => {
      if (timer || reduced.matches || items.length < 2) return;
      timer = window.setInterval(step, 2600);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    start();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  }
</script>
