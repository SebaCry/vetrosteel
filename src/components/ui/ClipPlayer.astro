---
import { getImage } from 'astro:assets';
import { asset, hasAsset } from '../../lib/images';

/**
 * Muted, looping clip that loads and plays only once it is on screen — the
 * eight clips together are ~17MB, so nothing is fetched until it is needed.
 *
 * `watermark` covers the bottom-right corner with the Vetro Steel badge. The
 * generated clips carry the Gemini sparkle at roughly 86-91% across and
 * 81-89% down, so the badge is sized to sit over it with margin.
 */
interface Props {
  slug: string;
  title: string;
  watermark?: boolean;
  ratio?: string;
  class?: string;
  /**
   * Playback window in seconds. The source files are all 10s and only their
   * opening seconds are usable, so playback is fenced to [start, end) and
   * loops inside it. No re-encode: the media fragment lets the browser
   * range-request roughly the part we actually play.
   */
  start?: number;
  end?: number;
  /**
   * `card` is the framed clip used through the pages. `background` fills its
   * container edge to edge for the hero: no frame, no ring, a larger poster,
   * and it starts loading immediately instead of waiting to be scrolled to.
   */
  variant?: 'card' | 'background';
}

const {
  slug,
  title,
  watermark = false,
  ratio = 'aspect-video',
  class: className = '',
  start,
  end,
  variant = 'card',
} = Astro.props;

const isBackground = variant === 'background';

const trimmed = typeof start === 'number' && typeof end === 'number' && end > start;
const src = trimmed ? `/video/${slug}.mp4#t=${start},${end}` : `/video/${slug}.mp4`;

// The background fills the viewport, so its poster needs more pixels than a
// card's — it is what paints before the video has a single frame decoded.
const posterKey = `posters/${slug}.jpg`;
const poster = hasAsset(posterKey)
  ? (await getImage({ src: asset(posterKey), width: isBackground ? 1920 : 1024, format: 'webp' })).src
  : undefined;
---

<div
  class={`clip overflow-hidden bg-ink ${
    isBackground ? 'absolute inset-0' : `relative ${ratio}`
  } ${className}`}
  data-clip
  data-eager={isBackground ? '' : undefined}
>
  <video
    class:list={['absolute inset-0 w-full h-full object-cover', isBackground && 'clip-bg']}
    data-src={src}
    data-start={trimmed ? start : undefined}
    data-end={trimmed ? end : undefined}
    poster={poster}
    muted
    loop={!trimmed}
    playsinline
    preload="none"
    disablepictureinpicture
    tabindex="-1"
    aria-label={title}
  ></video>

  {
    watermark && (
      <div class="clip-badge absolute right-0 bottom-0 z-10 pointer-events-none">
        <img src="/logo.png" alt="" aria-hidden="true" class="clip-badge-mark" />
      </div>
    )
  }

  {!isBackground && <div class="absolute inset-0 ring-1 ring-inset ring-white/10 pointer-events-none" />}

  <button
    type="button"
    data-clip-toggle
    class={`clip-toggle absolute z-20 ${isBackground ? 'right-3 top-3' : 'left-3 bottom-3'}`}
    aria-label={`Play ${title}`}
    aria-pressed="false"
  >
    <svg data-icon-play width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <svg data-icon-pause width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden>
      <path d="M7 4h4v16H7zM13 4h4v16h-4z"></path>
    </svg>
  </button>
</div>

<style>
  /* The badge sits over the generated-watermark corner. A soft scrim keeps the
     mark legible whether the frame behind it is a dark floor or a white wall. */
  .clip-badge {
    width: 44%;
    min-width: 10rem;
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0.7rem 0.9rem;
    /* Opaque enough near the corner that the clip's own baked-in mark cannot
       ghost through beside ours. */
    background: radial-gradient(
      125% 125% at 100% 100%,
      rgba(7, 30, 36, 0.96) 0%,
      rgba(7, 30, 36, 0.9) 42%,
      rgba(7, 30, 36, 0.55) 66%,
      rgba(7, 30, 36, 0) 84%
    );
  }
  .clip-badge-mark {
    width: 56%;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  /* The generated sparkle sits at roughly 86-91% across and 81-89% down. As a
     full-bleed backdrop it is plainly visible, and a badge big enough to cover
     it would dominate the hero — so the frame is scaled from its top-left
     corner until that corner falls outside the box and gets clipped. */
  .clip-bg {
    /* A continuous push-in can never cut back to its first frame cleanly, so
       the last moments dissolve through the backdrop instead. */
    transition: opacity 0.45s linear;
  }

  /* Only wide viewports need the crop. On anything narrower, object-cover has
     already thrown away the outer thirds of a 16:9 frame, so the sparkle is
     gone on its own and scaling would just cost resolution. */
  @media (min-width: 1024px) {
    .clip-bg {
      transform: scale(1.22);
      transform-origin: left top;
    }
  }
  [data-eager][data-looping='true'] .clip-bg {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip-bg {
      transition: none;
    }
  }

  .clip-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--color-warm-gray);
    background-color: rgba(7, 30, 36, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s, background-color 0.3s, border-color 0.3s;
  }
  .clip:hover .clip-toggle,
  .clip-toggle:focus-visible {
    opacity: 1;
  }
  /* Looping motion behind the hero headline has to be pausable without
     hunting for it (WCAG 2.2.2), and there is no hover on a phone. */
  [data-eager] .clip-toggle {
    opacity: 0.55;
  }
  [data-eager]:hover .clip-toggle {
    opacity: 1;
  }
  .clip-toggle:hover {
    background-color: var(--color-deep-teal);
    border-color: var(--color-sand);
  }

  /* Without autoplay the control is the only way in, so it always shows. */
  @media (prefers-reduced-motion: reduce) {
    .clip-toggle {
      opacity: 1;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-clip]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('video');
    const toggle = root.querySelector<HTMLButtonElement>('[data-clip-toggle]');
    const iconPlay = root.querySelector<SVGElement>('[data-icon-play]');
    const iconPause = root.querySelector<SVGElement>('[data-icon-pause]');
    if (!video || !toggle) return;

    let loaded = false;
    /** Set by the user; once they take control, the observer stops overriding. */
    let manual = false;

    const start = Number(video.dataset.start ?? NaN);
    const end = Number(video.dataset.end ?? NaN);
    const trimmed = Number.isFinite(start) && Number.isFinite(end);

    const load = () => {
      if (loaded) return;
      loaded = true;
      video.src = video.dataset.src!;
    };

    if (trimmed) {
      // The `#t=` fragment already seeks and stops, but browsers disagree on
      // whether it fires `ended` or just pauses, and Safari overshoots a little.
      // Owning the loop here makes all of them behave the same.
      const rewind = () => {
        if (video.currentTime < start - 0.05 || video.currentTime >= end) {
          video.currentTime = start;
        }
      };
      video.addEventListener('loadedmetadata', rewind);
      const FADE = 0.45;
      video.addEventListener('timeupdate', () => {
        // Dip out just before the wrap so the jump back reads as a dissolve.
        root.dataset.looping = video.currentTime >= end - FADE ? 'true' : 'false';
        if (video.currentTime >= end) {
          video.currentTime = start;
          root.dataset.looping = 'false';
          if (video.paused && !manual) video.play().catch(() => {});
        }
      });
      video.addEventListener('ended', () => {
        video.currentTime = start;
        if (!manual) video.play().catch(() => {});
      });
    }

    const syncIcons = () => {
      const playing = !video.paused && !video.ended;
      iconPlay?.toggleAttribute('hidden', playing);
      iconPause?.toggleAttribute('hidden', !playing);
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.setAttribute(
        'aria-label',
        `${playing ? 'Pause' : 'Play'} ${video.getAttribute('aria-label') ?? 'clip'}`
      );
    };

    video.addEventListener('play', syncIcons);
    video.addEventListener('pause', syncIcons);

    toggle.addEventListener('click', () => {
      manual = true;
      if (video.paused) {
        load();
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });

    const eager = root.hasAttribute('data-eager');
    if (eager) {
      load();
      if (!reduced.matches) video.play().catch(() => {});
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              load();
              if (!manual && !reduced.matches) video.play().catch(() => {});
            } else if (!video.paused) {
              video.pause();
              // Leaving the viewport is not the user pausing it.
              if (!manual) video.currentTime = video.currentTime;
            }
          }
        },
        { threshold: 0.45 }
      );
      io.observe(root);
    }

    syncIcons();
  });
</script>
