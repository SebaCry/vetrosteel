---
import { Icon } from 'astro-icon/components';
import MaterialNote from './MaterialNote.astro';
import { contact } from '../../data/site';

/** Phone, WhatsApp and social profiles. Icons always show; they link once `contact` has the URL. */
interface Props {
  class?: string;
  /** Flag missing links as pending material. Off in the footer, where it would repeat on every page. */
  note?: boolean;
}
const { class: className = '', note = true } = Astro.props;

const { phoneDisplay, phoneDigits } = contact;
const icons = [
  ...contact.social,
  { label: 'WhatsApp', icon: 'lucide:message-circle', href: phoneDigits ? `https://wa.me/${phoneDigits}` : '' },
];
const missing = [
  !phoneDigits && 'the phone number (also used for the WhatsApp link)',
  ...contact.social.filter((s) => !s.href).map((s) => `the ${s.label} profile URL`),
].filter(Boolean);
---

<div class={className}>
  {
    phoneDigits && (
      <ul class="space-y-3 text-sm">
        <li>
          <a href={`tel:+${phoneDigits}`} class="inline-flex items-center gap-2.5 hover:text-sand transition-colors">
            <Icon name="lucide:phone" class="size-4 text-sand" />
            {phoneDisplay || `+${phoneDigits}`}
          </a>
        </li>
      </ul>
    )
  }

  <!-- Always shown (client wants the icons visible now). An icon without its
       URL yet renders as a plain badge rather than a dead link. -->
  <ul class="mt-5 flex gap-3">
    {icons.map((s) => (
      <li>
        {s.href ? (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            class="grid place-items-center size-10 border border-white/15 text-warm-gray/75 hover:text-sand hover:border-sand transition-colors"
          >
            <Icon name={s.icon} class="size-[1.15rem]" />
          </a>
        ) : (
          <span
            title={s.label}
            class="grid place-items-center size-10 border border-white/15 text-warm-gray/75"
          >
            <Icon name={s.icon} class="size-[1.15rem]" aria-label={s.label} />
          </span>
        )}
      </li>
    ))}
  </ul>

  {note && missing.length > 0 && <MaterialNote where="Phone & social links" needs={`Still needed: ${missing.join(', ')}.`} />}
</div>
