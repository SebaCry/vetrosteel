---
interface Props {
  variant?: 'full' | 'mark';
  tone?: 'light' | 'dark';
  /**
   * Height utilities. Passed separately from `class` because Tailwind orders
   * conflicting utilities by its own sort, not by attribute order — a caller
   * writing `class="h-14"` lost to a hardcoded `h-40` here, which is what made
   * the fixed header 174px tall on phones.
   */
  size?: string;
  class?: string;
}
const {
  variant = 'full',
  tone = 'light',
  size,
  class: className = '',
} = Astro.props;

const sizeClass = size ?? (variant === 'full' ? 'h-40 w-auto' : 'h-16 w-16');
// logo-light.png is logo.png with the teal ink turned to paper white and the
// gold S kept, trimmed of its ~30% empty margin. The old `brightness-0 invert`
// flattened the gold into a white silhouette, and the margin shrank the
// wordmark to a few pixels — the client's "the logo can't be seen".
const src = tone === 'light' ? '/logo-light.png' : '/logo.png';
---

<img
  src={src}
  alt="Vetro Steel"
  class={`shrink-0 object-contain ${sizeClass} ${className}`}
  loading="eager"
  decoding="async"
/>
